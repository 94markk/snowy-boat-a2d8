---
import { SITE } from "../config";
import { LOCALES, LOCALE_NAMES, type Locale } from "../i18n/ui";
import { localePath, swapLocale, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const nav = [
  { href: localePath(locale), label: t("nav.home") },
  { href: localePath(locale, "shop"), label: t("nav.shop") },
  { href: localePath(locale, "wallet"), label: t("nav.wallet") },
  { href: localePath(locale, "account"), label: t("nav.account") },
];

const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => current === href.replace(/\/+$/, "");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath(locale)}>
      <span class="brand-mark" aria-hidden="true">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
          <path
            d="M4 9h16l-1 9.2a2.4 2.4 0 0 1-2.4 2.1H7.4A2.4 2.4 0 0 1 5 18.2L4 9Z"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linejoin="round"></path>
          <path d="M9 9V7a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
          ></path>
        </svg>
      </span>
      <span class="brand-name">
        {/* Two spellings, one shown at a time by CSS: the full name needs more
            width than a phone header has next to the language switch. */}
        <b class="brand-full">{SITE.name}</b>
        <b class="brand-short">{SITE.shortName}</b>
        <span>Powered by {SITE.legalName}</span>
      </span>
    </a>

    <nav aria-label={t("nav.menu")}>
      <ul class="desktop-nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label={t("a11y.langSwitch")}>
        {
          LOCALES.map((alt) => (
            <a
              href={swapLocale(Astro.url, alt)}
              hreflang={alt}
              lang={alt}
              title={LOCALE_NAMES[alt]}
              aria-current={alt === locale ? "true" : undefined}
            >
              {alt}
            </a>
          ))
        }
      </div>

      <a class="icon-button" href={localePath(locale, "cart")}>
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M3 4h2.1l2 10.2a1.8 1.8 0 0 0 1.8 1.4h7.5a1.8 1.8 0 0 0 1.8-1.4L20 7.4H5.8"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="9.5" cy="19.4" r="1.4" fill="currentColor"></circle>
          <circle cx="16.5" cy="19.4" r="1.4" fill="currentColor"></circle>
        </svg>
        <span class="visually-hidden">{t("nav.cart")}</span>
        <span class="count-bubble" data-cart-count hidden aria-hidden="true">0</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { cartCount, onCartChange } from "../lib/cart";

  function render() {
    const count = cartCount();
    for (const bubble of document.querySelectorAll<HTMLElement>("[data-cart-count]")) {
      bubble.textContent = String(count);
      bubble.hidden = count === 0;
    }
  }

  render();
  onCartChange(render);
</script>
