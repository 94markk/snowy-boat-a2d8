---
import { startingPrice, type Product } from "../data/catalog";
import type { Locale } from "../i18n/ui";
import { formatMoney, localePath, useTranslations } from "../i18n/utils";

interface Props {
  product: Product;
  locale: Locale;
  /** Shows the rank crown instead of the badge, for the best-seller rail. */
  showRank?: boolean;
  eager?: boolean;
}

const { product, locale, showRank = false, eager = false } = Astro.props;
const t = useTranslations(locale);

const href = localePath(locale, `shop/${product.slug}`);
const from = startingPrice(product);
const badge = product.badges?.[0];

const badgeLabel =
  badge === "top-vente"
    ? t("badge.topVente")
    : badge === "promo"
      ? t("badge.promo")
      : badge === "nouveau"
        ? t("badge.nouveau")
        : null;

const kindIcon =
  product.category === "jeux"
    ? "M7 9h10a3.4 3.4 0 0 1 3.3 2.6l.8 3.5a2.2 2.2 0 0 1-4.1 1.4L16 15H8l-1 1.5a2.2 2.2 0 0 1-4.1-1.4l.8-3.5A3.4 3.4 0 0 1 7 9Z"
    : product.category === "abonnement"
      ? "M4 6.5h16v11H4zM9.8 10.3l4.6 2.2-4.6 2.2z"
      : "M4 10.5h16v8.5H4zM3.6 7h16.8v3.5H3.6zM12 7v12";
---

<article class="product-card">
  <div class="product-card-media">
    <span class="chip chip-kind" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
        <path d={kindIcon} stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      </svg>
    </span>

    {
      showRank && product.rank !== undefined ? (
        <span class="chip chip-rank">#{product.rank}</span>
      ) : (
        badgeLabel && (
          <span class="chip chip-badge" data-badge={badge}>
            {badgeLabel}
          </span>
        )
      )
    }

    <button
      class="fav-button"
      type="button"
      aria-pressed="false"
      aria-label={t("a11y.favorite")}
      data-favorite={product.id}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 20s-7.2-4.4-7.2-9.3A4.1 4.1 0 0 1 12 8.2a4.1 4.1 0 0 1 7.2 2.5C19.2 15.6 12 20 12 20Z"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <img
      src={product.image}
      alt={product.name}
      width="400"
      height="400"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </div>

  <div class="product-card-body">
    <h3 class="product-card-title">
      <a href={href}>{product.name}{product.region ? ` (${product.region})` : ""}</a>
    </h3>
    <p class="product-card-price">
      {t("product.from")} <strong>{formatMoney(from, locale)}</strong>
    </p>
    <a class="btn btn-primary" href={href}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 4h2.1l2 10.2a1.8 1.8 0 0 0 1.8 1.4h7.5a1.8 1.8 0 0 0 1.8-1.4L20 7.4H5.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {t("product.buy")}
    </a>
  </div>
</article>

<script>
  import { isFavorite, toggleFavorite } from "../lib/favorites";

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-favorite]")) {
    const id = button.dataset.favorite!;
    button.setAttribute("aria-pressed", String(isFavorite(id)));
    button.addEventListener("click", () => {
      button.setAttribute("aria-pressed", String(toggleFavorite(id)));
    });
  }
</script>
