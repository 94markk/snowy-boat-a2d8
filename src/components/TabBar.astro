---
/**
 * The fixed bottom navigation shown on phones, mirroring the current app:
 * Accueil · Wallet · Boutique (raised) · Panier · Compte.
 */
import type { Locale } from "../i18n/ui";
import { localePath, useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => current === href.replace(/\/+$/, "");
---

<nav class="tabbar" aria-label={t("nav.menu")}>
  <a href={localePath(locale)} aria-current={isCurrent(localePath(locale)) ? "page" : undefined}>
    <span class="tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m4 10.5 8-6 8 6V19a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19v-8.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      </svg>
    </span>
    <span>{t("nav.home")}</span>
  </a>

  <a href={localePath(locale, "wallet")} aria-current={isCurrent(localePath(locale, "wallet")) ? "page" : undefined}>
    <span class="tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="6" width="18" height="12.5" rx="2.5" stroke="currentColor" stroke-width="1.8"></rect>
        <path d="M3 10.5h18" stroke="currentColor" stroke-width="1.8"></path>
      </svg>
    </span>
    <span>{t("nav.wallet")}</span>
  </a>

  <a class="tab-primary" href={localePath(locale, "shop")}>
    <span class="tab-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 9h16v10.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"></path>
        <path d="M3 5.5h18L20 9H4L3 5.5Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"></path>
      </svg>
    </span>
    <span>{t("nav.shop")}</span>
  </a>

  <a href={localePath(locale, "cart")} aria-current={isCurrent(localePath(locale, "cart")) ? "page" : undefined}>
    <span class="tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 4h2.1l2 10.2a1.8 1.8 0 0 0 1.8 1.4h7.5a1.8 1.8 0 0 0 1.8-1.4L20 7.4H5.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="9.5" cy="19.4" r="1.4" fill="currentColor"></circle>
        <circle cx="16.5" cy="19.4" r="1.4" fill="currentColor"></circle>
      </svg>
      <span class="count-bubble" data-cart-count hidden aria-hidden="true">0</span>
    </span>
    <span>{t("nav.cart")}</span>
  </a>

  <a href={localePath(locale, "account")} aria-current={isCurrent(localePath(locale, "account")) ? "page" : undefined}>
    <span class="tab-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="M5 20a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </span>
    <span>{t("nav.account")}</span>
  </a>
</nav>
