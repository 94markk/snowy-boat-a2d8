---
import Icon from './Icon.astro';
---

<header class="topbar" id="topbar">
  <div class="topbar-left">
    <a class="brand" href="/" aria-label="Cutline">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="26" height="26">
          <defs>
            <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#22d3ee" />
              <stop offset="1" stop-color="#8b5cf6" />
            </linearGradient>
          </defs>
          <rect x="2" y="2" width="28" height="28" rx="8" fill="url(#brand-g)" />
          <path d="M11 9.5v13l11-6.5z" fill="#0b0b0f" />
          <path d="M8 24 24 8" stroke="#0b0b0f" stroke-width="2.4" stroke-linecap="round" />
        </svg>
      </span>
      <span class="brand-name">Cutline</span>
    </a>
    <button class="icon-btn" id="btn-projects" type="button" title="Projects">
      <Icon name="folder" />
    </button>
    <input id="project-name" class="project-name" type="text" aria-label="Project name" maxlength="80" spellcheck="false" />
    <span id="save-status" class="save-status" data-state="saved" role="status">Saved</span>
  </div>

  <div class="topbar-center">
    <button class="icon-btn" type="button" data-cmd="undo" title="Undo (Ctrl+Z)" disabled><Icon name="undo" /></button>
    <button class="icon-btn" type="button" data-cmd="redo" title="Redo (Ctrl+Shift+Z)" disabled><Icon name="redo" /></button>
  </div>

  <div class="topbar-right">
    <button class="icon-btn" id="btn-shortcuts" type="button" title="Keyboard shortcuts (?)">
      <Icon name="keyboard" />
    </button>
    <button class="btn btn-primary" id="btn-export" type="button">
      <Icon name="download" size={16} />
      <span>Export</span>
    </button>
  </div>
</header>
