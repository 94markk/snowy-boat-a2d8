---
import CategoryNav from "../../../components/CategoryNav.astro";
import ProductCard from "../../../components/ProductCard.astro";
import SearchForm from "../../../components/SearchForm.astro";
import { products } from "../../../data/catalog";
import { localeStaticPaths } from "../../../i18n/paths";
import type { Locale } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";
import Base from "../../../layouts/Base.astro";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<Base title={t("shop.title")} description={t("shop.intro")} locale={locale}>
  <div class="container section">
    <h1>{t("shop.title")}</h1>
    <p class="lead">{t("shop.intro")}</p>

    <SearchForm locale={locale} />

    <div class="spacer"></div>
    <CategoryNav locale={locale} />

    <div class="product-grid">
      {products.map((product, index) => <ProductCard product={product} locale={locale} eager={index < 4} />)}
    </div>
  </div>
</Base>

<style>
  .spacer {
    height: 1.75rem;
  }
</style>
