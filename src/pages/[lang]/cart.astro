---
import { PAYMENT_ACCOUNTS } from "../../config";
import type { Locale } from "../../i18n/ui";
import { formatMoney, localePath, useTranslations } from "../../i18n/utils";
import Base from "../../layouts/Base.astro";

/** On demand, so the wallet balance and sign-in state are current. */
export const prerender = false;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const user = Astro.locals.user;
---

<Base title={t("cart.title")} description={t("cart.title")} locale={locale} noindex>
  <div
    class="container section"
    data-region
    data-loading="true"
    data-locale={locale}
    data-shop-url={localePath(locale, "shop")}
    data-wallet-url={localePath(locale, "wallet")}
    data-account-url={localePath(locale, "account")}
    data-signed-in={user ? "true" : "false"}
    data-balance={user ? String(user.balanceCentimes) : "0"}
    data-account-orders-url={localePath(locale, "account")}
    data-providers={JSON.stringify(PAYMENT_ACCOUNTS)}
  >
    <h1>{t("cart.title")}</h1>

    {
      user && (
        <p class="balance-line">
          {t("cart.balance")}: <strong>{formatMoney(user.balanceCentimes, locale)}</strong>
        </p>
      )
    }

    <div data-cart-body>
      <p class="lead">{t("cart.updating")}</p>
    </div>
  </div>
</Base>

<script>
  import { getVariant } from "../../data/catalog";
  import { PAYMENT_ACCOUNTS } from "../../config";
import type { Locale } from "../../i18n/ui";
  import { formatMoney, isLocale, useTranslations } from "../../i18n/utils";
  import { onCartChange, readCart, removeAt, setQty } from "../../lib/cart";

  const region = document.querySelector<HTMLElement>("[data-region]");
  const body = document.querySelector<HTMLElement>("[data-cart-body]");

  if (region && body) {
    const raw = region.dataset.locale;
    const locale: Locale = isLocale(raw) ? raw : "fr";
    const t = useTranslations(locale);

    const shopUrl = region.dataset.shopUrl ?? "/";
    const walletUrl = region.dataset.walletUrl ?? "/";
    const accountUrl = region.dataset.accountUrl ?? "/";
    const signedIn = region.dataset.signedIn === "true";
    const balance = Number(region.dataset.balance ?? 0);

    /** Built with DOM APIs rather than innerHTML, so nothing stored in the cart
     *  can ever be parsed as markup. */
    const el = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      props: Record<string, string | undefined> = {},
      children: (Node | string)[] = [],
    ): HTMLElementTagNameMap[K] => {
      const node = document.createElement(tag);
      for (const [key, value] of Object.entries(props)) {
        if (value === undefined) continue;
        if (key === "class") node.className = value;
        else if (key === "text") node.textContent = value;
        else node.setAttribute(key, value);
      }
      for (const child of children) node.append(child);
      return node;
    };

    function renderEmpty() {
      body!.replaceChildren(
        el("div", { class: "empty-state" }, [
          el("p", { text: t("cart.empty") }),
          el("a", { class: "btn btn-primary", href: shopUrl, text: t("cart.emptyCta") }),
        ]),
      );
      region!.dataset.loading = "false";
    }

    function render() {
      const stored = readCart();
      if (stored.length === 0) return renderEmpty();

      const list = el("ul", { class: "cart-lines" });
      let total = 0;

      stored.forEach((line, index) => {
        const found = getVariant(line.variantId);
        // A variant that has left the catalog cannot be priced, so drop it.
        if (!found) {
          removeAt(index);
          return;
        }

        const { product, variant } = found;
        const lineTotal = variant.priceCentimes * line.qty;
        total += lineTotal;

        const decrement = el("button", { type: "button", "aria-label": "-", text: "−" });
        decrement.addEventListener("click", () => setQty(index, line.qty - 1));

        const increment = el("button", { type: "button", "aria-label": "+", text: "+" });
        increment.addEventListener("click", () => setQty(index, line.qty + 1));

        const remove = el("button", { class: "link-button", type: "button", text: t("cart.remove") });
        remove.addEventListener("click", () => removeAt(index));

        // Show the details the customer typed, so a wrong player id is visible
        // before they pay rather than after.
        const detailText = Object.values(line.fields).filter(Boolean).join(" · ");

        list.append(
          el("li", { class: "cart-line" }, [
            el("div", { class: "cart-line-media" }, [
              el("img", {
                src: product.image,
                alt: product.name,
                width: "68",
                height: "68",
                loading: "lazy",
                decoding: "async",
              }),
            ]),
            el("div", {}, [
              el("p", {
                class: "cart-line-name",
                text: `${product.name}${product.region ? ` (${product.region})` : ""} — ${variant.label[locale]}`,
              }),
              el("p", {
                class: "cart-line-meta",
                text: detailText || formatMoney(variant.priceCentimes, locale),
              }),
              el("div", { class: "qty-control" }, [
                decrement,
                el("output", { text: String(line.qty) }),
                increment,
              ]),
              remove,
            ]),
            el("span", { class: "cart-line-total", text: formatMoney(lineTotal, locale) }),
          ]),
        );
      });

      /* ---- Payment method ------------------------------------------- */

      const providers = JSON.parse(region!.dataset.providers ?? "{}") as Record<
        string,
        { label: string; number: string }
      >;

      const methodSelect = el("select", { name: "method" });
      // The wallet is only offered when it can actually cover the order.
      if (balance >= total) {
        methodSelect.append(el("option", { value: "wallet", text: t("cart.methodWallet") }));
      }
      for (const [id, account] of Object.entries(providers)) {
        methodSelect.append(el("option", { value: id, text: account.label }));
      }

      const phoneInput = el("input", {
        type: "tel",
        name: "payerMsisdn",
        inputmode: "tel",
        placeholder: "3412 3456",
        maxlength: "20",
      });

      const phoneField = el("label", { class: "field" }, [
        el("span", { text: t("wallet.payerPhone") }),
        phoneInput,
        el("span", { class: "field-help", text: t("wallet.payerPhoneHelp") }),
      ]);

      /** The phone number is only relevant when paying by mobile money. */
      function syncMethod() {
        phoneField.hidden = methodSelect.value === "wallet";
      }
      methodSelect.addEventListener("change", syncMethod);

      const payButton = el("button", {
        class: "btn btn-primary btn-block",
        type: "button",
        text: t("cart.payNow"),
      });

      const alertBox = el("p", { class: "form-alert", "data-tone": "error", hidden: "hidden" });

      const summaryChildren: (Node | string)[] = [
        el("div", { class: "summary-row total" }, [
          el("span", { text: t("cart.total") }),
          el("span", { text: formatMoney(total, locale) }),
        ]),
      ];

      if (!signedIn) {
        summaryChildren.push(
          el("p", { class: "form-alert", "data-tone": "error", text: t("cart.signInFirst") }),
          el("a", { class: "btn btn-primary btn-block", href: accountUrl, text: t("account.signIn") }),
        );
      } else {
        if (balance > 0) {
          summaryChildren.push(
            el("div", { class: "summary-row" }, [
              el("span", { text: t("cart.balance") }),
              el("span", { text: formatMoney(balance, locale) }),
            ]),
          );
        }

        summaryChildren.push(
          el("label", { class: "field" }, [el("span", { text: t("cart.method") }), methodSelect]),
          phoneField,
          payButton,
          alertBox,
        );

        payButton.addEventListener("click", () =>
          pay(methodSelect.value, phoneInput.value, total, payButton, alertBox),
        );
      }

      summaryChildren.push(
        el("p", { class: "summary-continue" }, [
          el("a", { href: shopUrl, text: t("cart.continue") }),
        ]),
      );

      body!.replaceChildren(
        el("div", { class: "cart-layout" }, [list, el("aside", { class: "summary" }, summaryChildren)]),
      );
      syncMethod();
      region!.dataset.loading = "false";
    }

    /** Maps an API error code to something the customer can act on. */
    function messageFor(code: string | undefined): string {
      switch (code) {
        case "insufficient_funds":
          return t("cart.insufficient");
        case "too_many_pending":
          return t("cart.duplicatePending");
        case "invalid_phone":
          return t("cart.invalidPhone");
        default:
          return t("cart.error");
      }
    }

    async function pay(
      method: string,
      payerMsisdn: string,
      total: number,
      button: HTMLButtonElement,
      alertBox: HTMLElement,
    ) {
      if (method !== "wallet" && !payerMsisdn.trim()) {
        alertBox.textContent = t("cart.invalidPhone");
        alertBox.hidden = false;
        return;
      }

      button.disabled = true;
      button.textContent = t("cart.processing");
      alertBox.hidden = true;

      try {
        const response = await fetch("/api/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            locale,
            method,
            payerMsisdn,
            items: readCart().map((line) => ({
              variantId: line.variantId,
              qty: line.qty,
              fields: line.fields,
            })),
          }),
        });

        const payload = (await response.json()) as any;
        if (!response.ok || !payload.ok) throw new Error(payload.error ?? "failed");

        // The basket has become an order either way, so it is cleared here.
        localStorage.removeItem("delica.cart.v2");

        if (payload.status === "awaiting_payment") {
          showPaymentInstructions(payload, total);
          return;
        }

        window.location.assign(`${accountUrl}?order=${encodeURIComponent(payload.reference ?? "")}`);
      } catch (error) {
        alertBox.textContent = messageFor(error instanceof Error ? error.message : undefined);
        alertBox.hidden = false;
        button.disabled = false;
        button.textContent = t("cart.payNow");
      }
    }

    /**
     * Replaces the cart with what the customer has to do next. Nothing has been
     * charged at this point — the order settles when their payment SMS arrives.
     */
    function showPaymentInstructions(payload: any, total: number) {
      const minutes = Math.max(1, Math.round((payload.expiresAt - Date.now() / 1000) / 60));

      const row = (label: string, value: string) =>
        el("div", {}, [el("dt", { text: label }), el("dd", { text: value })]);

      body!.replaceChildren(
        el("div", { class: "pay-instructions" }, [
          el("h2", { text: t("cart.awaitingTitle") }),
          el("p", { text: t("cart.awaitingBody") }),
          el("dl", {}, [
            row(t("wallet.sendTo"), `${payload.payTo.label} — ${payload.payTo.number}`),
            row(t("wallet.exactAmount"), formatMoney(payload.totalCentimes ?? total, locale)),
            row(t("cart.orderRef"), String(payload.reference ?? "")),
            row(t("wallet.expiresIn"), `${minutes} ${t("wallet.minutes")}`),
          ]),
          el("p", { class: "waiting", text: t("wallet.waiting") }),
          el("a", {
            class: "btn btn-ghost",
            href: region!.dataset.accountOrdersUrl ?? accountUrl,
            text: t("cart.viewOrders"),
          }),
        ]),
      );
      region!.dataset.loading = "false";
    }

    render();
    onCartChange(render);
  }
</script>

<style>
  .balance-line {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .summary-continue {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.875rem;
  }
</style>
