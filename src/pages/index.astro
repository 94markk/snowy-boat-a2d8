---
import '../styles/editor.css';
import TopBar from '../components/editor/TopBar.astro';
import Library from '../components/editor/Library.astro';
import Player from '../components/editor/Player.astro';
import Inspector from '../components/editor/Inspector.astro';
import Timeline from '../components/editor/Timeline.astro';
import Dialogs from '../components/editor/Dialogs.astro';

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:ital,wght@0,400;0,700;1,400;1,700&family=Montserrat:ital,wght@0,400;0,700;1,700&family=Oswald:wght@400;700&family=Bebas+Neue&family=Anton&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Lobster&family=Pacifico&family=Permanent+Marker&family=Roboto+Mono:wght@400;700&display=swap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0f" />
    <title>Cutline — Video Editor</title>
    <meta name="description" content="A free, private, in-browser video editor with a multi-track timeline, text, stickers, transitions, filters, effects, keyframes and export." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
  </head>
  <body>
    <div class="app" id="app">
      <TopBar />
      <main class="workspace">
        <Library />
        <Player />
        <Inspector />
      </main>
      <div class="tl-resizer" id="tl-resizer" role="separator" aria-orientation="horizontal" aria-label="Resize timeline"></div>
      <Timeline />
    </div>
    <Dialogs />
    <script>
      import '../editor/main.ts';
    </script>
  </body>
</html>
