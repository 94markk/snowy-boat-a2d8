---
/**
 * The bare domain. Cloudflare serves the `_redirects` rule first, so most
 * visitors never see this page; it exists as a fallback for any host that does
 * not honour `_redirects`.
 */
import { DEFAULT_LOCALE } from "../i18n/ui";

const target = `/${DEFAULT_LOCALE}/`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Delica Store</title>
  </head>
  <body>
    <p><a href={target}>Delica Store</a></p>
  </body>
</html>
