{
  "name": "delicastoreha",
  "description": "Delica Store — boutique en ligne trilingue (FR/EN/HT) sur Astro + Cloudflare Workers.",
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20250204.0",
    "playwright": "^1.63.0",
    "wrangler": "^4.131.2"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check && tsc --noEmit",
    "deploy": "astro build && wrangler deploy",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "test": "node --import ./tests/helpers/register.mjs --test \"tests/*.test.js\"",
    "types": "wrangler types",
    "test:e2e": "node tests/e2e.mjs"
  },
  "type": "module",
  "private": true
}
